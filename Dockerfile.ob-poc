# syntax=docker/dockerfile:1
#
# Build context: ob-poc/ repository root (one level above rust/)
# Builds the ob-poc-web binary (axum web server + federated bus, T7 stack).
#
# Usage (from ob-poc/):
#   docker build -f Dockerfile.ob-poc -t ob-poc-app:local .
#
# BPMN and shared DSL/SemOS crates are exact Git dependencies. No sibling
# checkout is copied into the build context.

# ── Stage 1: chef ────────────────────────────────────────────────────
FROM rust:1.95-bookworm AS chef
RUN cargo install cargo-chef --locked \
    && cargo install cargo-auditable --version 0.7.5 --locked
WORKDIR /build

# ── Stage 2: planner ─────────────────────────────────────────────────
FROM chef AS planner
# Copy the full ob-poc workspace and its runtime evaluation inputs.
COPY rust/ rust/
COPY eval/ eval/
WORKDIR /build/rust
RUN cargo chef prepare --recipe-path recipe.json

# ── Stage 3: builder ─────────────────────────────────────────────────
FROM chef AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends libprotobuf-dev protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

COPY --from=planner /build/rust/recipe.json /build/rust/recipe.json

# Cook dependencies before full copy (Docker layer cache).
COPY eval/ /build/eval/
WORKDIR /build/rust
RUN cargo chef cook --release -p ob-poc-web --recipe-path recipe.json

COPY rust/ /build/rust/
COPY eval/ /build/eval/
RUN cargo auditable build --release -p ob-poc-web \
    && mkdir -p /build/out \
    && cp target/release/ob-poc-web /build/out/ob-poc-web \
    && strip /build/out/ob-poc-web

# ── Stage 4: runtime ─────────────────────────────────────────────────
FROM gcr.io/distroless/cc-debian12:nonroot

ARG APP_REVISION
ARG SHARED_DSL_REVISION
ARG BPMN_LITE_REVISION

LABEL org.opencontainers.image.title="ob-poc" \
      org.opencontainers.image.revision="${APP_REVISION}" \
      io.ob-poc.shared-dsl-revision="${SHARED_DSL_REVISION}" \
      io.ob-poc.bpmn-lite-revision="${BPMN_LITE_REVISION}"

ENV OB_POC_BUILD_REVISION="${APP_REVISION}" \
    OB_POC_SHARED_DSL_REVISION="${SHARED_DSL_REVISION}" \
    OB_POC_BPMN_LITE_REVISION="${BPMN_LITE_REVISION}"

WORKDIR /app

COPY --from=builder /build/out/ob-poc-web /usr/local/bin/

# Copy ob-poc config (verbs, packs, seeds — required at runtime).
COPY --chown=nonroot:nonroot rust/config/ /app/config/

EXPOSE 3000 50061

# Required env: DATABASE_URL
# Optional bus env: OB_POC_BUS_LISTEN (default unset → bus disabled)
#                   BPMN_LITE_BUS_ENDPOINT
#                   OB_POC_CATALOGUE_VERSION (default v1.0.0)
# Optional agent env: AGENT_BACKEND, ANTHROPIC_API_KEY, ANTHROPIC_MODEL
CMD ["ob-poc-web"]
